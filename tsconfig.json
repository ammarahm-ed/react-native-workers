{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@ammarahmed/react-native-workers": ["./src/index"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "ammarahmed-react-native-workers-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  // The Docusaurus site is its own TypeScript project: it resolves `@site/*`
  // through aliases only Docusaurus knows about, and type-checks itself during
  // its build. Checking it from here reports its imports as unresolvable.
  "exclude": ["docs"]
}
