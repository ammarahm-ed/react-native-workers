{
  "name": "@ammarahmed/react-native-workers-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:tests": "RN_WORKERS_SCREEN=tests react-native start --reset-cache",
    "start:benchmarks": "RN_WORKERS_SCREEN=benchmarks react-native start --reset-cache",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug --extra-params \"EXCLUDED_ARCHS=x86_64\"",
    "web": "vite",
    "build:web": "vite build"
  },
  "dependencies": {
    "@nativescript/react-native": "9.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.0",
    "react-native-blob-util": "0.24.10",
    "react-native-gzip": "^1.1.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-mmkv-storage": "^12.0.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-uiworker-demo": "link:../example-modules/uiworker-demo",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-monorepo-config": "^0.4.0",
    "vite": "^7.1.1",
    "vite-plugin-commonjs": "^0.10.4"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
